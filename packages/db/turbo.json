{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "prisma/**"],
			"outputs": ["src/generated/**"],
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"dev:prepare": {
			"cache": false,
			"inputs": [
				"prisma/schema.prisma",
				"prisma/migrations/**",
				"prisma.config.ts",
				"scripts/prepare-dev.ts",
				"scripts/require-local-db.ts"
			],
			"outputs": ["src/generated/**"],
			"passThroughEnv": [
				"ALLOW_REMOTE_DB",
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:generate": {
			"inputs": ["$TURBO_DEFAULT$", "prisma/**"],
			"outputs": ["src/generated/**"],
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:deploy": {
			"cache": false,
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:migrate": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:push": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:reset": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:seed": {
			"cache": false,
			"passThroughEnv": [
				"BLOB_READ_WRITE_TOKEN",
				"R2_ACCOUNT_ID",
				"R2_ACCESS_KEY_ID",
				"R2_SECRET_ACCESS_KEY",
				"R2_BUCKET",
				"R2_PUBLIC_BASE",
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "build"],
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		}
	}
}
