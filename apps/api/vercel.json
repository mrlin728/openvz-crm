{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"outputDirectory": "public",
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/api"
		}
	],
	"crons": [
		{
			"path": "/internal/sync/mailboxes",
			"schedule": "0 1 * * *"
		},
		{
			"path": "/internal/sync/rates",
			"schedule": "0 6 * * *"
		}
	]
}
