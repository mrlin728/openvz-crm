{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OPENVZ CRM",
	"version": "1.1.0",
	"identifier": "ai.openvz.crm",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "OPENVZ CRM",
				"width": 1280,
				"height": 860,
				"minWidth": 960,
				"minHeight": 640,
				"resizable": true,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "nsis"],
		"category": "Business",
		"shortDescription": "Every customer, one place.",
		"longDescription": "OPENVZ CRM runs entirely on this computer. It carries its own database, so there is nothing to host and no account to create.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": ["payload.tar.gz"],
		"macOS": {
			"minimumSystemVersion": "11.0"
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"languages": ["English", "SimpChinese"]
			}
		}
	}
}
